{
    "name": "mmft24/elastic-apm-symfony-bundle",
    "type": "symfony-bundle",
    "description": "Integrate Elastic APM into Symfony",
    "keywords": ["elastic", "apm", "monitoring", "performance", "metrics", "symfony", "symfony-bundle"],
    "homepage": "https://github.com/mmft24/elastic-apm-symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "psr/log": "^1.0|^2.0|^3.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0"
    },
    "suggest": {
        "ext-elastic_apm": "To send data to Elastic APM. Without it the bundle falls back to a no-op interactor.",
        "monolog/monolog": "^3.0 to add trace.id/transaction.id/span.id to log records (elastic_apm.log_correlation).",
        "symfony/messenger": "To propagate distributed tracing through Symfony Messenger and trace consumed messages as transactions."
    },
    "require-dev": {
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "monolog/monolog": "^3.0",
        "nyholm/symfony-bundle-test": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5|^13.0",
        "rector/rector": "^2.2",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/messenger": "^6.4|^7.0|^8.0",
        "symfony/phpunit-bridge": "^8.0.0",
        "symfony/property-access": "^6.4|^7.0|^8.0",
        "symfony/property-info": "^6.4|^7.0|^8.0",
        "symfony/serializer": "^6.4|^7.0|^8.0",
        "symplify/easy-coding-standard": "^13.0",
        "vimeo/psalm": "^6.13"
    },
    "autoload": {
        "psr-4": {
            "ElasticApmBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElasticApmBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    }
}
